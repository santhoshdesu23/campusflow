# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campusflow?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=campusflow_jwt_secure_secret_key_2026

# Google Gemini API Key (optional - if omitted, built-in intelligent demo extractor is used)
GEMINI_API_KEY=

# Allowed Client Origin for CORS (e.g. Vercel frontend URL, comma-separated if multiple)
CLIENT_URL=http://localhost:5173

# Server Port (Render automatically sets process.env.PORT)
PORT=5000

# Demo Mode toggle ('true' or 'false')
DEMO_MODE=true
